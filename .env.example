# LathikaMart Environment Configuration Example
# Copy to .env or set environment variables in application server

# Database Settings (H2 Engine)
DB_URL=jdbc:h2:mem:lathikamart;DB_CLOSE_DELAY=-1;MODE=MySQL
DB_DRIVER=org.h2.Driver
DB_USER=sa
DB_PASSWORD=

# HikariCP Connection Pool Settings
HIKARI_MAX_POOL_SIZE=10
HIKARI_MIN_IDLE=2
HIKARI_IDLE_TIMEOUT=30000
HIKARI_CONNECTION_TIMEOUT=30000

# Server Port
PORT=9090

# AI Provider Configuration (mock | gemini)
AI_CHATBOT_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
